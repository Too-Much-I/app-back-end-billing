{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tosunsaeng:withdrawal-recovery:r1",
  "$comment": "Identity proposed recovery-r1; joint acceptance pending. Validate the route-specific $defs. Raw UTF-8 byte limit, duplicate keys, trailing JSON and semantic relationships require separate checks.",
  "$defs": {
    "D0": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])"
    },
    "D1": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])"
    },
    "U32": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4]|4294967295)(?![\\s\\S])"
    },
    "UserId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "NewId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "Instant": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}|[+-][0-9]{5,10})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3}(?:[0-9]{3}){0,2})?Z(?![\\s\\S])",
      "$comment": "Additionally parse as java.time.Instant and require Instant.toString() equality; regex alone does not validate calendar or canonical fraction."
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[!-~]+(?![\\s\\S])"
    },
    "NullableCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "CreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamId"
      ],
      "properties": {
        "streamId": {
          "$ref": "#/$defs/NewId"
        }
      }
    },
    "StatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId"
      ],
      "properties": {
        "snapshotId": {
          "$ref": "#/$defs/NewId"
        }
      }
    },
    "SnapshotPageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "cursor"
      ],
      "properties": {
        "snapshotId": {
          "$ref": "#/$defs/NewId"
        },
        "cursor": {
          "$ref": "#/$defs/NullableCursor"
        }
      }
    },
    "FeedPageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamId",
        "afterSequence",
        "scanCursor"
      ],
      "properties": {
        "streamId": {
          "$ref": "#/$defs/NewId"
        },
        "afterSequence": {
          "$ref": "#/$defs/D0"
        },
        "scanCursor": {
          "$ref": "#/$defs/NullableCursor"
        }
      }
    },
    "T": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "increment"
      ],
      "properties": {
        "seconds": {
          "$ref": "#/$defs/U32"
        },
        "increment": {
          "$ref": "#/$defs/U32"
        }
      }
    },
    "Range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromSequence",
        "toSequence"
      ],
      "properties": {
        "fromSequence": {
          "$ref": "#/$defs/D1"
        },
        "toSequence": {
          "$ref": "#/$defs/D1"
        }
      }
    },
    "SnapshotItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "withdrawnAt"
      ],
      "properties": {
        "userId": {
          "$ref": "#/$defs/UserId"
        },
        "withdrawnAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "schemaVersion",
        "userId",
        "withdrawnAt"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/UserId"
        },
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "userId": {
          "$ref": "#/$defs/UserId"
        },
        "withdrawnAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "FeedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/D1"
        },
        "event": {
          "$ref": "#/$defs/Event"
        }
      }
    },
    "KnownGap": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fromSequence",
            "toSequence"
          ],
          "properties": {
            "kind": {
              "const": "LEGACY_HISTORY"
            },
            "fromSequence": {
              "type": "null"
            },
            "toSequence": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fromSequence",
            "toSequence"
          ],
          "properties": {
            "kind": {
              "const": "SOURCE_RANGE"
            },
            "fromSequence": {
              "$ref": "#/$defs/D1"
            },
            "toSequence": {
              "$ref": "#/$defs/D1"
            }
          }
        }
      ]
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "streamId",
        "T",
        "H",
        "itemCount",
        "pageCount",
        "contentDigest",
        "legacyCoverage",
        "knownGaps",
        "expiresAt"
      ],
      "properties": {
        "snapshotId": {
          "$ref": "#/$defs/NewId"
        },
        "streamId": {
          "$ref": "#/$defs/NewId"
        },
        "T": {
          "$ref": "#/$defs/T"
        },
        "H": {
          "$ref": "#/$defs/D0"
        },
        "itemCount": {
          "$ref": "#/$defs/D0"
        },
        "pageCount": {
          "$ref": "#/$defs/D1"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "legacyCoverage": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "knownGaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnownGap"
          }
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "FailureCode": {
      "enum": [
        "SNAPSHOT_HISTORY_LOST",
        "SNAPSHOT_BUILD_TIMEOUT",
        "SNAPSHOT_BUILD_FAILED"
      ]
    },
    "SnapshotStatus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshotId",
            "status"
          ],
          "properties": {
            "snapshotId": {
              "$ref": "#/$defs/NewId"
            },
            "status": {
              "const": "BUILDING"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshotId",
            "status",
            "manifest"
          ],
          "properties": {
            "snapshotId": {
              "$ref": "#/$defs/NewId"
            },
            "status": {
              "const": "READY"
            },
            "manifest": {
              "$ref": "#/$defs/Manifest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshotId",
            "status",
            "failureCode"
          ],
          "properties": {
            "snapshotId": {
              "$ref": "#/$defs/NewId"
            },
            "status": {
              "const": "FAILED"
            },
            "failureCode": {
              "$ref": "#/$defs/FailureCode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshotId",
            "status"
          ],
          "properties": {
            "snapshotId": {
              "$ref": "#/$defs/NewId"
            },
            "status": {
              "const": "EXPIRED"
            }
          }
        }
      ]
    },
    "SnapshotPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor",
        "done"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/SnapshotItem"
          }
        },
        "nextCursor": {
          "$ref": "#/$defs/NullableCursor"
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamId",
        "replayFloor",
        "observedThroughSequence",
        "checkedFromExclusive",
        "checkedThroughSequence",
        "observedAt"
      ],
      "properties": {
        "streamId": {
          "$ref": "#/$defs/NewId"
        },
        "replayFloor": {
          "$ref": "#/$defs/D0"
        },
        "observedThroughSequence": {
          "$ref": "#/$defs/D0"
        },
        "checkedFromExclusive": {
          "$ref": "#/$defs/D0"
        },
        "checkedThroughSequence": {
          "$ref": "#/$defs/D0"
        },
        "observedAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "FeedPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "scanCursor",
        "targetThroughSequence",
        "nextAfterSequence",
        "scannedThrough",
        "done",
        "availability"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/FeedItem"
          }
        },
        "scanCursor": {
          "$ref": "#/$defs/Cursor"
        },
        "targetThroughSequence": {
          "$ref": "#/$defs/D0"
        },
        "nextAfterSequence": {
          "$ref": "#/$defs/D0"
        },
        "scannedThrough": {
          "$ref": "#/$defs/D0"
        },
        "done": {
          "type": "boolean"
        },
        "availability": {
          "$ref": "#/$defs/Availability"
        }
      }
    },
    "GapDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamId",
        "replayFloor",
        "observedThroughSequence",
        "missingSequence",
        "unavailableRange",
        "observedAt"
      ],
      "properties": {
        "streamId": {
          "$ref": "#/$defs/NewId"
        },
        "replayFloor": {
          "$ref": "#/$defs/D0"
        },
        "observedThroughSequence": {
          "$ref": "#/$defs/D0"
        },
        "missingSequence": {
          "$ref": "#/$defs/D1"
        },
        "unavailableRange": {
          "type": "null"
        },
        "observedAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "ReplayDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamId",
        "replayFloor",
        "observedThroughSequence",
        "missingSequence",
        "unavailableRange",
        "observedAt"
      ],
      "properties": {
        "streamId": {
          "$ref": "#/$defs/NewId"
        },
        "replayFloor": {
          "$ref": "#/$defs/D0"
        },
        "observedThroughSequence": {
          "$ref": "#/$defs/D0"
        },
        "missingSequence": {
          "$ref": "#/$defs/D1"
        },
        "unavailableRange": {
          "$ref": "#/$defs/Range"
        },
        "observedAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "Error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "INVALID_REQUEST"
            },
            "message": {
              "const": "Invalid recovery request."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "SNAPSHOT_NOT_FOUND"
            },
            "message": {
              "const": "Snapshot not found."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "REQUEST_TOO_LARGE"
            },
            "message": {
              "const": "Recovery request exceeds the byte limit."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "UNSUPPORTED_CONTRACT"
            },
            "message": {
              "const": "Unsupported recovery contract."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "OPERATION_CONFLICT"
            },
            "message": {
              "const": "Operation is bound to a different request."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "STREAM_REPLACED"
            },
            "message": {
              "const": "Withdrawal stream has been replaced."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "SNAPSHOT_NOT_READY"
            },
            "message": {
              "const": "Snapshot is still building."
            },
            "retryable": {
              "const": true
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "SNAPSHOT_FAILED"
            },
            "message": {
              "const": "Snapshot build failed. Check snapshot status."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId",
            "details"
          ],
          "properties": {
            "code": {
              "const": "COVERAGE_GAP"
            },
            "message": {
              "const": "Required withdrawal source is missing."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            },
            "details": {
              "$ref": "#/$defs/GapDetails"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId",
            "details"
          ],
          "properties": {
            "code": {
              "const": "REPLAY_UNAVAILABLE"
            },
            "message": {
              "const": "Required withdrawal source is no longer replayable."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            },
            "details": {
              "$ref": "#/$defs/ReplayDetails"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "SNAPSHOT_EXPIRED"
            },
            "message": {
              "const": "Snapshot has expired."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "CURSOR_EXPIRED"
            },
            "message": {
              "const": "Recovery cursor has expired."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "SOURCE_AVAILABILITY_UNCERTAIN"
            },
            "message": {
              "const": "Withdrawal source availability is uncertain."
            },
            "retryable": {
              "const": true
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "SOURCE_UNAVAILABLE"
            },
            "message": {
              "const": "Withdrawal source is temporarily unavailable."
            },
            "retryable": {
              "const": true
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "correlationId"
          ],
          "properties": {
            "code": {
              "const": "RESPONSE_LIMIT_EXCEEDED"
            },
            "message": {
              "const": "Recovery response exceeds the byte limit."
            },
            "retryable": {
              "const": false
            },
            "correlationId": {
              "$ref": "#/$defs/NewId"
            }
          }
        }
      ]
    }
  }
}
